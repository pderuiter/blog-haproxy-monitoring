# {{ ansible_managed }}
global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

# Prometheus metrics frontend
frontend prometheus
    bind *:{{ haproxy_metrics_prometheus_port }}
    mode http
    http-request use-service prometheus-exporter if { path /metrics }
    no log
    stats enable
    stats uri /stats
    stats refresh 10s

# Stats page for human viewing
frontend stats
    bind *:{{ haproxy_metrics_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST

# Application frontends and backends
frontend http_front
    bind *:80
{% if haproxy_metrics_tls %}
    bind *:443 ssl crt {{ haproxy_metrics_cert_dir }}/
{% endif %}
    default_backend web_servers

backend web_servers
    balance roundrobin
    option httpchk {{ haproxy_metrics_health_check }}
{% for server in haproxy_metrics_backend_servers %}
    server {{ server.name }} {{ server.address }}:{{ server.port }} check
{% endfor %}
