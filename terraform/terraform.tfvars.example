proxmox_endpoint  = "https://pve.example.com:8006/"
proxmox_api_token = "terraform@pve!blog=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = false
node_name         = "pve"
vm_datastore_id   = "local-lvm"
bridge            = "vmbr0"
gateway           = "10.0.0.254"
dns_servers       = ["192.0.2.53"]
ssh_public_key    = "ssh-ed25519 AAAAC3Nza... you@example.com"

vms = {
  haproxy1    = { ip = "10.0.0.10/24", groups = ["haproxy"] }
  prometheus1 = { ip = "10.0.0.20/24", groups = ["prometheus"], memory = 2048, disk_size = 20 }
}
